# Erforderlicher PostgreSQL-Benutzer. Der Compose-Stack startet nicht ohne einen nichtleeren Wert.
POSTGRES_USER=school_assistant

# Erforderliches Datenbankpasswort. Vor dem ersten Start durch ein individuelles Passwort ersetzen.
POSTGRES_PASSWORD=

# Erforderlicher Name der PostgreSQL-Datenbank.
POSTGRES_DB=school_assistant

# Erforderliche SQLAlchemy-URL für Backend und Worker. Passwortinhalte URL-kodieren.
# Beispielschema: postgresql+psycopg://BENUTZER:PASSWORT@postgres:5432/DATENBANK
DATABASE_URL=

# Laufzeitmodus des Backends. Bei APP_ENV=production werden Platzhalterwerte für
# SECRET_KEY, ADMIN_PASSWORD und INTEGRATION_ENCRYPTION_KEY abgelehnt: der Start bricht ab.
APP_ENV=development

# Aktiviert Backend-Debugausgaben nur in einer bewusst isolierten Entwicklungsumgebung.
DEBUG=false

# Erforderlicher zufälliger Schlüssel mit ausreichender Länge. Niemals den Beispielwert aus einer anderen Umgebung übernehmen.
SECRET_KEY=

# Erforderlicher Schlüssel zum Verschlüsseln der Integrations-Zugangsdaten (WebUntis, KI-Provider).
# Mit HKDF wird daraus ein AES-GCM-Schlüssel abgeleitet. Ein Wechsel des Werts macht gespeicherte
# Zugangsdaten unlesbar, also vor der ersten Nutzung stabil festlegen und sicher aufbewahren.
INTEGRATION_ENCRYPTION_KEY=

# Zeitlimit in Sekunden für den Verbindungstest einer Integration (1 bis 120).
INTEGRATION_TIMEOUT_SECONDS=10

# Holt den Stundenplan planmäßig im Backend, statt nur auf einen Klick in den Einstellungen.
# Der erste Lauf wartet 30 Sekunden nach dem Start, danach greift das Intervall.
# Der Klick in den Einstellungen holt weiterhin immer, auch am selben Tag.
WEBUNTIS_SYNC_ENABLED=false

# Abstand zweier planmäßiger Abrufe in Sekunden (maximal 604800, also eine Woche).
# Maßgeblich ist last_sync_at: wurde heute schon geholt, springt der Lauf.
WEBUNTIS_SYNC_INTERVAL_SECONDS=86400

# Bootstrap-Benutzername für das Backend.
ADMIN_USERNAME=admin

# Erforderliches Bootstrap-Adminpasswort. Vor dem ersten Start durch ein individuelles Passwort ersetzen.
ADMIN_PASSWORD=

# Stellt den Bootstrap-Administrator beim Backend-Start sicher, wenn er noch nicht existiert.
BOOTSTRAP_ON_STARTUP=true

# Aktiviert die serverseitige Authentifizierung.
AUTH_ENABLED=true

# Aktiviert explizite Demo-Daten und Demo-Fallbacks. Für reale Daten false lassen.
DEMO_MODE=false

# Name und Lebensdauer des HttpOnly-Session-Cookies.
SESSION_COOKIE_NAME=school_session
SESSION_MAX_AGE_SECONDS=604800

# Für HTTPS auf true setzen. Bei reinem lokalem HTTP bleibt der Wert false.
# Hinter einem TLS-Reverse-Proxy MUSS der Wert true sein, sonst wird das Session-Cookie
# ohne Secure-Flag ausgeliefert. Der Wert wird bewusst NICHT aus APP_ENV=production
# abgeleitet: dieselbe Compose-Datei wird für Tests und lokalen Betrieb im Klartext
# benutzt, und ein stillschweigend gesetztes Secure-Flag macht dort jede Anmeldung
# unmöglich, ohne dass die Ursache am Response sichtbar wäre.
# Siehe docs/server.md, Abschnitt "Betrieb hinter HTTPS".
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# Limit für fehlgeschlagene Log-in-Versuche pro Client und Benutzername.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Kommagetrennte Origin(s), die das Backend direkt aufrufen dürfen.
CORS_ORIGINS=http://localhost:3000

# Logging und IANA-Zeitzone.
LOG_LEVEL=INFO
SCHOOL_TIMEZONE=Europe/Berlin

# Serverinternes Rewrite-Ziel des Next.js-Frontends. Für Docker Compose auf http://backend:8000 belassen.
BACKEND_INTERNAL_URL=http://backend:8000

# Host-Port des Frontends. Nur ändern, wenn lokal bereits ein Dienst Port 3000 belegt.
FRONTEND_PORT=3000

# Im Browser sichtbarer Demo-Fallback. Nur für ausdrücklich gewünschte Demo-Betriebsarten aktivieren.
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false

# Reservierte Host-Verzeichnisse für Dokumente, Backups, Importe und lokale Modelle.
# Relative Pfade werden relativ zur Compose-Datei aufgelöst; absolute Pfade sind ebenfalls möglich.
DOCUMENTS_HOST_PATH=./data/documents
BACKUPS_HOST_PATH=./data/backups
IMPORTS_HOST_PATH=./data/imports
MODELS_HOST_PATH=./data/models

# Stabile interne Containerpfade. Diese Ziele werden durch die Compose-Mounts fest vorgegeben.
DOCUMENT_STORAGE_PATH=/var/lib/school-assistant/documents
BACKUP_STORAGE_PATH=/var/lib/school-assistant/backups
IMPORT_STORAGE_PATH=/var/lib/school-assistant/imports

# Lokale KI-Modelle. Der Mount muss read/write sein, sonst liegen die Gewichte
# nach einem Neustart nur im Container-Overlay und sind weg. Der Katalog liegt im
# Code (`app/services/model_catalog.py`); diese Werte steuern nur die Ablage.
MODEL_STORAGE_PATH=/var/lib/school-assistant/models
MODEL_DOWNLOAD_TIMEOUT_SECONDS=60
MODEL_MIN_FREE_BYTES=536870912

# Erinnerungen an faellige Aufgaben und Klausuren. Wie WEBUNTIS_SYNC_ENABLED in
# Settings absichtlich `false`, damit ein nativer Start nichts ungefragt tut.
REMINDER_SCHEDULER_ENABLED=false
# Abstand der Erinnerungsläufe in Sekunden (60 bis 86400).
# REMINDER_INTERVAL_SECONDS=300

# Hinweis zu den auskommentierten Zeilen: Compose reicht nur die Variablen an das
# Backend weiter, die in docker-compose.yml unter `environment:` stehen. Die
# folgenden auskommentierten Werte wirken deshalb beim nativen Start (uvicorn,
# Desktop) sofort, im Compose-Stack erst nach einem Eintrag dort.

# Sprach-Assistent. Ohne Laufzeit ist der Textmodus der Normalzustand - das ist
# Absicht, kein Fehlerzustand. whisper.cpp bringt seinen eigenen HTTP-Dienst mit
# und laeuft ausserhalb des Containers, daher die URL statt eines Prozesses.
# `localhost` ist hier der Container, nicht der Host: fuer einen Server auf dem
# Host `host.docker.internal` verwenden.
SPEECH_ENABLED=false
WHISPER_SERVER_URL=
WHISPER_SERVER_TIMEOUT_SECONDS=120
WHISPER_LANGUAGE=de
PIPER_BINARY_PATH=
# Pfad zu ffmpeg; wandelt WebM/MP4-Aufnahmen in 16-kHz-WAV. Im Backend-Image enthalten.
# FFMPEG_BINARY_PATH=ffmpeg
# Grenzen einer Aufnahme bzw. eines Vorlesetexts (12 MiB, 120 Sekunden, 4000 Zeichen).
# SPEECH_MAX_UPLOAD_BYTES=12582912
# SPEECH_MAX_SECONDS=120
# SPEECH_MAX_TEXT_CHARACTERS=4000
# Leer = automatisch: kleinstes geladenes Whisper-Modell bzw. eine deutsche Stimme.
# SPEECH_STT_MODEL_ID=
# SPEECH_TTS_VOICE_ID=

# Eingebaute Laufzeiten (llama-server, whisper-server, Piper) von GitHub laden und
# selbst starten. Die Desktop-App schaltet das ein; im Docker-Stack aus lassen.
# LOCAL_RUNTIMES_ENABLED=false
# Hintergrund-Indexer für Fotos/Scans und Einbettungen. Desktop: immer an.
# MATERIAL_INDEXER_ENABLED=false

# Persönliches LoRA-Training (optional, nur NVIDIA/Apple Silicon), siehe docs/konfiguration.md.
# Eigenes Python mit torch/CUDA; leer = Training nicht eingerichtet.
# TRAINER_PYTHON=
# Ordner mit lernraum_trainer.py; leer = trainer/ im Repository.
# TRAINER_DIR=
# Ziel der von der App eingerichteten Trainer-Umgebung (~6 GB); leer = <MODEL_STORAGE_PATH>/trainer-env.
# TRAINER_ENV_PATH=
# Hugging-Face-Ablage der Basisgewichte; leer = <MODEL_STORAGE_PATH>/trainer-cache.
# TRAINER_CACHE_PATH=

# Lokale KI-Routen. `local` zuerst, weil es nichts kostet und nichts versendet;
# das Budget ist kuerzer, wenn ein Online-Provider im Rueckgrat steht, damit ein
# langsamer CPU-Modelllauf den Nutzer nicht laenger warten laesst als noetig.
# Noten gehen auch lokal nur mit `share_grades_with_ai` raus - Standard aus.
AI_LOCAL_FIRST=true
AI_LOCAL_TIMEOUT_SECONDS=60
AI_LOCAL_FAST_TIMEOUT_SECONDS=15
AI_GENERATE_TIMEOUT_SECONDS=30

# Web-Push. Ohne diese beiden Werte laeuft der lokale Weg, die Einstellungen
# sagen das als Klartext. Ein Paar erzeugt `generate_vapid_keypair()`; der
# oeffentliche Schluessel wird daraus berechnet und muss nicht eingetragen werden.
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Optional; muss zum privaten Schlüssel passen. Leer = wird daraus berechnet.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# Zeitlimit eines Push-Versands in Sekunden (1 bis 120).
# WEB_PUSH_TIMEOUT_SECONDS=10

# Backup-Zeitplan und Aufbewahrung. Wird im Worker ausgewertet, nicht vom Backend.
# Der Cron-Ausdruck wird in SCHOOL_TIMEZONE gedeutet, damit er nicht vom Host abhaengt.
# Unterstuetzt sind `*`, `N`, `N-M`, `N-M/S`, `*/S` und Kommalisten.
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
# Wo der Worker `pg_dump` sucht. Leer lassen, dann wird shutil.which und danach
# /usr/lib/postgresql/*/bin/pg_dump probiert.
BACKUP_PG_DUMP_BINARY=

# Intervalle und Grenzen für den schlanken Datenbank- und Heartbeat-Worker.
WORKER_POLL_INTERVAL_SECONDS=300
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEALTH_MAX_AGE_SECONDS=120

# Statusdatei im eigenen Named Volume. Der Worker darf nur dieses Volume beschreiben.
WORKER_STATUS_PATH=/var/lib/school-assistant/worker-status/worker-status.json

# Reservierte KI-Konfiguration für eine spätere Integration. Der aktuelle Stack verwendet keine KI-API.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=2048

# Reservierte WebUntis-Konfiguration für eine spätere Integration.
WEBUNTIS_BASE_URL=
WEBUNTIS_SCHOOL=
WEBUNTIS_USERNAME=
WEBUNTIS_PASSWORD=

# Reservierte iCalendar-Konfiguration für eine spätere Integration.
ICAL_CALENDAR_URL=
CALENDAR_REFRESH_INTERVAL_SECONDS=900
